# HTTP ve www isteklerini canonical HTTPS adresine yonlendir
<IfModule mod_rewrite.c>
RewriteEngine On

# www -> non-www HTTPS
RewriteCond %{HTTP_HOST} ^www\.fortispergola\.com$ [NC]
RewriteRule ^ https://fortispergola.com%{REQUEST_URI} [R=301,L,NE]

# HTTP -> HTTPS (proxy/CDN arkasinda donguyu onler)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://fortispergola.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

